{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emrtc:hardware-evidence-run-manifest:1",
  "title": "EMRTC Evidence Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "target_profile",
    "capture_profile",
    "started_at_utc",
    "operator",
    "software",
    "environment",
    "hardware",
    "artifacts",
    "result",
    "review",
    "hardware_claim_allowed",
    "deviations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9_]+_[0-9]{3}$"
    },
    "run_type": {
      "enum": [
        "simulation",
        "ethercat_hardware",
        "canopen_hardware"
      ]
    },
    "target_profile": {
      "type": "string",
      "minLength": 1
    },
    "capture_profile": {
      "type": "string",
      "minLength": 1
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "worktree_clean",
        "build_type"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_clean": {
          "type": "boolean"
        },
        "build_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "operating_system",
        "runtime",
        "cycle_time_ns"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "cycle_time_ns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "manufacturer",
          "model",
          "asset_id",
          "firmware"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string"
          },
          "firmware": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "required",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "ABORTED",
        "INCOMPLETE"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewed_at_utc"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "hardware_claim_allowed": {
      "type": "boolean"
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
